
# Credential tùy chọn; giữ trống, không commit giá trị thật.
# Quyền truy cập Hugging Face
HF_TOKEN=

# Nhà cung cấp sinh ảnh, nếu backend được chọn cần credential
IMAGE_API_KEY=

# Development dự kiến; chưa có loader đọc .env hoặc mock pipeline.
# Các giá trị tương ứng configs/settings.yaml; xem docs/environment.md.
STORY_BACKEND=mock
IMAGE_BACKEND=mock
DEVICE=cpu
OUTPUT_DIR=outputs
MAX_RETRIES=2
