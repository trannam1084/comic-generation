# Template để caller tự export environment; không có implicit .env loader.
# load_pipeline_config(environ=os.environ) chỉ đọc các config keys được document.
STORY_BACKEND=mock
IMAGE_BACKEND=mock
STORY_DEVICE=cpu
IMAGE_DEVICE=cpu
OUTPUT_DIR=outputs
MAX_RETRIES=auto
BASE_SEED=42
STORY_CACHE_DIR=
# DEVICE là alias cũ cho cả hai stages; không kết hợp với split device fields.
# Qwen: STORY_BACKEND=qwen và STORY_DEVICE=cuda:0; giữ IMAGE_DEVICE=cpu.

# Credentials không được configuration loader đọc hoặc lưu; không điền giá trị thật vào Git.
HF_TOKEN=
IMAGE_API_KEY=
